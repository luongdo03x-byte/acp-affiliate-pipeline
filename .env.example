# Runtime config template. `./manage.sh setup` copies this file to
# shared/.env.local on first bootstrap and never overwrites it again --
# never commit the real shared/.env.local (it holds live secrets).

# --------------------------------------------------------------- Lõi app
# "production" bắt buộc ACP_SECRET_KEY + ACP_ADMIN_PASSWORD (fail sớm nếu
# thiếu). Để trống hoặc "dev" -> chạy không cần đăng nhập, chỉ dùng cục bộ.
ACP_ENV=
# Đường dẫn CSDL SQLite. ./manage.sh setup tự điền theo shared/var/acp.db
# của máy này -- không copy nguyên dòng này từ máy khác.
ACP_DB=
# Khoá mã hoá token kênh (base64 của 32 byte). ./manage.sh setup tự sinh
# bằng `run.py genkey`. Đổi khoá sẽ làm mất khả năng giải mã token đã lưu
# -- nếu chuyển máy mà muốn giữ nguyên kết nối Threads đã có, copy khoá
# CŨ sang thay vì để setup sinh khoá mới.
ACP_MASTER_KEY=

# mock = dữ liệu giả lập, không gọi API/Threads thật. live = dùng nguồn
# thật (cần các biến ACCESSTRADE_*/Threads bên dưới).
ACP_ADAPTER=mock
ACP_SOURCE=mock

# --------------------------------------------------------- Web/bảo mật
ACP_ADMIN_PASSWORD=
# Khoá ký session Flask. Để trống -> tự sinh ngẫu nhiên mỗi lần khởi động
# (session mất khi restart); đặt cố định nếu muốn session sống qua restart.
ACP_SECRET_KEY=
# Khoá bắt buộc trên query string của URL webhook postback (?k=<secret>).
ACP_WEBHOOK_SECRET=

# ------------------------------------------------------------- Media/URL
# local = lưu ảnh trên đĩa, phục vụ qua chính Flask (chỉ dùng được nếu
# Meta/Threads có thể tải URL này qua Internet -- không phải localhost).
ACP_STORAGE=local
ACP_MEDIA_BASE_URL=http://localhost:5000/media
# URL public (vd. domain ngrok cố định) dùng cho OAuth callback Threads.
ACP_PUBLIC_BASE_URL=

# ------------------------------------------------------------ Caption LLM
# Để trống -> chỉ dùng template tĩnh (không gọi ra ngoài). "gemini" bật
# viết lại caption bằng Gemini free tier -- cần ACP_GEMINI_API_KEY.
ACP_CAPTION_LLM=
ACP_GEMINI_API_KEY=

# --------------------------------------------- ACCESSTRADE TikTok Shop
# Copy các giá trị này vào .env.local runtime rồi mới đặt token; không
# commit file runtime.
ACCESSTRADE_API_BASE_URL=https://api.accesstrade.vn
ACCESSTRADE_API_TOKEN=

# Catalog sync chạy độc lập với Flask, gọi an toàn từ cron/systemd timer.
ACP_PRODUCT_SYNC_ENABLED=true
ACP_PRODUCT_SYNC_INTERVAL_MINUTES=60
ACP_PRODUCT_SYNC_MAX_PAGES=10
ACP_PRODUCT_REPOST_COOLDOWN_DAYS=7
ACP_PRODUCT_RECOMMENDATION_LIMIT=20

# Tự chuẩn bị bài là tuỳ chọn, luôn dừng ở PENDING_REVIEW để duyệt tay.
ACP_AUTO_PREPARE_CONTENT=false
ACP_AUTO_PREPARE_CONTENT_COUNT=3

# ------------------------------------------------- TikTok Shop (cũ, tuỳ chọn)
# Chỉ cần nếu còn dùng adapters/tiktokshop.py (nguồn cũ trước catalog
# ACCESSTRADE ở trên); catalog mới không đọc hai biến này.
AT_ACCESS_KEY=
AT_CAMPAIGN_ID=

# ----------------------------------------------- Shopee Affiliate Phase 1
# Affiliate ID lấy từ Shopee Affiliate > Thiết lập tài khoản.
# Chỉ đặt giá trị thật trong shared/.env.local; không commit vào Git.
SHOPEE_AFFILIATE_ID=
