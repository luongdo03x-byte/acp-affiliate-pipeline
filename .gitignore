# Secrets
/.env
/.env.*
!/.env.example
# secrets/*.gpg CỐ Ý được track -- đó là bản mã hoá GPG của .env.local
# (tạo bằng `./manage.sh encrypt-secrets`), không phải secret dạng chữ
# thường. Đừng thêm rule ignore /secrets ở đây.

# Runtime
/var
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Python
/.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/

# Local
*.log
*.pid
.idea/
.vscode/
.DS_Store

# Backup
/backups/

# Superpowers scratch workspace (SDD ledgers, briefs, review packages)
/.superpowers/
*.bak
