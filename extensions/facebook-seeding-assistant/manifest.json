{
  "manifest_version": 3,
  "name": "ACP Facebook Seeding Assistant",
  "version": "0.2.0",
  "description": "ACP-assisted Facebook target queue with fail-closed hybrid review and profile pairing.",
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://m.facebook.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {"service_worker": "background.js"},
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/*", "https://m.facebook.com/*"],
      "js": ["parser.js", "runner.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
